# Copy to .env (git-ignored) and fill in. Used by scripts/release.ps1 -Upload.
# Token: https://www.curseforge.com/account/api-tokens  (the "Upload API" token for wow.curseforge.com)
CURSEFORGE_API_TOKEN=
# Numeric project ID from your CurseForge project page ("About This Project").
CURSEFORGE_PROJECT_ID=
# Optional: override where build.ps1 copies the addon. Defaults to the Forever beta client.
# STOCKIST_WOW_PATH=C:\Program Files (x86)\World of Warcraft\_classic_beta_
